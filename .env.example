# Phase II: black-cat Q&A backend
# Copy this file to a local, ignored .env file or configure the same variables
# in the serverless/backend deployment environment. Never expose these values
# through a VITE_* variable.
PET_CHAT_API_KEY=
PET_CHAT_API_BASE_URL=
PET_CHAT_MODEL=

# Public frontend configuration. This is an endpoint URL, not a secret.
# On GitHub Pages, point it to the separately deployed serverless/backend proxy.
VITE_PET_CHAT_ENDPOINT=/api/pet-chat
